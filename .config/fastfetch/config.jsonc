{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/french_exit_logo.png",
    "width": 24,
    "height": 12,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "keys": "38;2;221;74;74",
      "title": "38;2;242;212;212"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "  {user-name-colored} @ {host-name-colored}"
    },
    {
      "type": "custom",
      "format": "  ───────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}"
    },
    {
      "type": "wm",
      "key": "   WM",
      "format": "Hyprland (Lua 0.57)"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "format": "{5}"
    },
    {
      "type": "shell",
      "key": "  󰞷 Shell",
      "format": "{3}"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime"
    },
    {
      "type": "custom",
      "format": "  ───────────────────────────────────────"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "  󰊴 GPU",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory"
    },
    {
      "type": "custom",
      "format": "  ───────────────────────────────────────"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "square"
    }
  ]
}
