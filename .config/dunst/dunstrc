[global]
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 250)
    origin = top-right
    offset = (12, 12)
    scale = 0
    notification_limit = 5

    ### Visual Style: French Exit (Dark Crimson, Rose Accent, Black) ###
    font = CaskaydiaCove Nerd Font Mono 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Borders & Padding ###
    corner_radius = 0
    icon_corner_radius = 0
    frame_width = 1
    frame_color = "#601D1E"
    separator_color = frame
    separator_height = 1
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12

    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0

    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    ### Actions & Interaction ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#050202"
    foreground = "#8c5556"
    frame_color = "#3d1415"
    timeout = 4

[urgency_normal]
    background = "#000000"
    foreground = "#f2d4d4"
    frame_color = "#a43536"
    timeout = 6

[urgency_critical]
    background = "#1a0607"
    foreground = "#ffffff"
    frame_color = "#dd4a4a"
    timeout = 0
