# French Exit theme for Fish shell (Dark Crimson / Rose-Tinted Monochrome)

set -g fish_color_normal f2d4d4
set -g fish_color_command dd4a4a --bold
set -g fish_color_keyword a43536 --bold
set -g fish_color_quote eaa2a6
set -g fish_color_redirection ff6b6d
set -g fish_color_end b38e8e
set -g fish_color_error 7a2627 --underline
set -g fish_color_param c28285
set -g fish_color_comment 601d1e --italics
set -g fish_color_selection --background=3d1415
set -g fish_color_search_match --background=601d1e
set -g fish_color_operator dd4a4a --bold
set -g fish_color_escape eaa2a6
set -g fish_color_autosuggestion 601d1e
set -g fish_color_cancel 7a2627

# Pager and completion menu
set -g fish_pager_color_progress 3d1415
set -g fish_pager_color_prefix dd4a4a --bold --underline
set -g fish_pager_color_completion f2d4d4
set -g fish_pager_color_description b38e8e
set -g fish_pager_color_selected_background --background=601d1e
set -g fish_pager_color_selected_prefix ffffff --bold
set -g fish_pager_color_selected_completion ffffff
set -g fish_pager_color_selected_description f2d4d4
set -g fish_pager_color_secondary_background --background=1a0607
